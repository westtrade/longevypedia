# Доступы к хостингу Джино.
# Файл не попадает на сервер и не коммитится (см. `.gitignore`).
# Хостинг, SSH-ключ и пароли описаны в файле `ДОСТУП-К-ХОСТИНГУ.md` в корне каталога
# проектов, рядом с репозиторием.

DEPLOY_HOST=example.hosting.myjino.ru

# Обычный FTP: у Джино это порт 21. Порт 2222 — это SFTP (mod_sftp), и по
# паролю он из OpenSSH не работает, только `curl` со схемой `sftp://`.
DEPLOY_PROTOCOL=ftp
DEPLOY_PORT=21

DEPLOY_USER=user_ftp
DEPLOY_PASS='пароль'

# Домашний каталог FTP-аккаунта уже указывает на каталог сайта,
# поэтому дерево проекта строится от корня.
DEPLOY_ROOT=/

DEPLOY_URL=https://example.com

# `public/` остаётся `public/`: фронт-контроллер, манифест Vite, шрифты и
# спрайт ищутся от корня приложения. `vendor/` уезжает целиком — на сервере
# нет composer, а `vendor/bsti/bolt` в рабочем дереве это симлинк.
DEPLOY_PATHS=app public src content data schemas taxonomy vendor
DEPLOY_ROOT_FILES=config.php .htaccess

# 1 — не проверять сертификат и ключ хоста (когда known_hosts недоступен).
DEPLOY_INSECURE=0

# 1 — записать на сервер минимальный `.env` (APP_ENV/BOLT_DEBUG/APP_URL).
DEPLOY_WRITE_ENV=1

# Проверка после загрузки: эти адреса должны отвечать 200...
DEPLOY_PAGES=/
# ...а эти — 404 или 403: код, конфиг и корпус наружу не отдаются.
DEPLOY_DENY=/config.php /vendor/autoload.php /var/ /content/ /schemas/ /src/ /app/ /data/ /taxonomy/
