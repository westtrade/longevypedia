{
	"name": "longevypedia/longevypedia",
	"description": "Open scientific knowledge base about longevity, aging biology and healthspan.",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": ">=8.2",
		"bsti/bolt": "*",
		"league/commonmark": "^2.6",
		"opis/json-schema": "^2.6",
		"symfony/yaml": "^7.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5"
	},
	"repositories": [
		{
			"type": "path",
			"url": "../bolt",
			"options": {
				"symlink": true
			}
		}
	],
	"autoload": {
		"psr-4": {
			"Longevypedia\\": "src/"
		},
		"files": [
			"src/Content/functions.php",
			"src/Design/functions.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Longevypedia\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"test": "phpunit",
		"check": "bolt check",
		"content": "php scripts/content-check.php",
		"repo": "php scripts/repo-check.php",
		"ui-kit": "php scripts/ui-kit-pages.php",
		"assets": "bolt assets --json"
	}
}
