# Переменные окружения Longevypedia.
#
# Файл-образец: скопируйте в `.env` и правьте под свою машину. `.env` в
# репозиторий не попадает (см. .gitignore) — здесь только имена и значения по
# умолчанию, которые совпадают с `config.php`.
#
# В DDEV ничего копировать не нужно: `APP_ENV` и `VITE_DEV_SERVER_URL` приходят
# из `.ddev/config.yaml` (`web_environment`), а `.env` читается уже после них.

# dev | production. Влияет на detail страницы ошибки, валидацию JSON Schema при
# чтении контента и на то, подключается ли Vite-dev-сервер.
APP_ENV=dev

# Подробная страница ошибки с трейсом. На публичном сервере — false.
BOLT_DEBUG=true

# Репозиторий, на который ведут ссылки «исходный Markdown» и «история изменений»
# на странице документа. Меняется при форке без правки шаблонов.
APP_REPOSITORY=https://github.com/westtrade/longevypedia
APP_BRANCH=main

# Порт Vite-dev-сервера. По умолчанию 5176 — его же печатает
# `php vendor/bin/bolt vite --port`. В DDEV порт задан в `.ddev/config.yaml`.
# VITE_PORT=5176

# Адрес dev-сервера, если он не выводится из DDEV. В DDEV задавать не нужно:
# VITE_DEV_SERVER_URL приходит из web_environment.
# VITE_DEV_SERVER_URL=https://longevypedia.localhost:5176
